<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Screening\Domain\Model\Invite" table="invite">
        <id name="id" type="string" length="100"/>
        <field name="title" type="string" length="200"/>
        <field name="description" type="text"/>
        <field name="startsAt" type="datetime_immutable"/>
        <field name="endsAt" type="datetime_immutable"/>
        <field name="attendeeCount" type="integer"/>
        <field name="attendeeLabels" type="json"/>
        <field name="userOptional" type="boolean"/>
        <field name="recurringSince" type="datetime_immutable" nullable="true"/>
        <field name="language" type="string" enum-type="App\Screening\Domain\Model\Language" length="2"/>
        <field name="organizerEmail" type="string" length="255" nullable="true"/>
        <field name="verdict" type="json" nullable="true"/>
        <field name="doorCheck" type="json" nullable="true"/>
        <field name="worthIt" type="boolean" nullable="true"/>
        <field name="status" type="string" enum-type="App\Screening\Domain\Model\InviteStatus" length="20"/>
    </entity>
</doctrine-mapping>
