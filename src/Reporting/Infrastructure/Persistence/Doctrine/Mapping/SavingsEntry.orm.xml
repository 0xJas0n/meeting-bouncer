<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Reporting\Domain\SavingsEntry" table="savings_entry">
        <id name="inviteId" type="string" length="100"/>
        <field name="decidedAt" type="datetime_immutable"/>
        <field name="outcome" type="string" length="20"/>
        <field name="personMinutes" type="integer"/>
        <field name="cents" type="integer"/>
        <field name="worthIt" type="boolean" nullable="true"/>
    </entity>
</doctrine-mapping>
